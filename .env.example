# Copy to .env.local and fill in. Never commit real values.

# --- AI ---
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gemini-2.5-flash-lite
AI_SECOND_FALLBACK_PROVIDER=openrouter
AI_SECOND_FALLBACK_MODEL=
EXTRACTOR_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# --- Supabase (server only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# runtime: transaction pooler, port 6543
DATABASE_URL=
# migrations and import scripts: direct connection, port 5432
DIRECT_DATABASE_URL=

# --- Supabase (browser: realtime "doorbell" only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Identity / security ---
IDENTITY_PROVIDER=demo
DEMO_LOGIN_ENABLED=true
SESSION_SECRET=
REP_ACCESS_CODE=
CRON_SECRET=

# --- Limits ---
DAILY_TOKEN_BUDGET=2000000
