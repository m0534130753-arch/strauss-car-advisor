{
  "name": "strauss-car-advisor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "import:excel": "tsx scripts/import-excel.ts",
    "import:usage": "tsx --env-file=.env.local scripts/import-usage-values.ts",
    "import:all": "npm run import:excel && npm run import:usage",
    "demo:reset": "tsx --env-file=.env.local scripts/demo-reset.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/react": "^4.0.152",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.148",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "csv-parse": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
