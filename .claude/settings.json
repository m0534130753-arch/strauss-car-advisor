{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run test:coverage)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run import:excel)",
      "Bash(npm run db:generate)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm run db:migrate)",
      "Bash(npm run import:usage)",
      "Bash(npm run import:all)",
      "Bash(npm run demo:reset)",
      "Edit(./data/strauss-rules.json)",
      "Edit(./data/source/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!./.env.example)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf *)"
    ]
  }
}
